# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it holds live secrets.

# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://pbbakehouse.com
SITE_URL=https://pbbakehouse.com

# ── Database (MySQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pb_bake_house

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=7d

# ── Admin (auto-created on first boot if it doesn't exist yet) ─
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Email (order notifications via SMTP) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# ── Bakery location (delivery distance origin + SEO structured data) ─
BAKERY_NAME=
BAKERY_ADDRESS=
BAKERY_LAT=
BAKERY_LNG=
BAKERY_MAPS_URL=
BAKERY_PLUS_CODE=

# ── Delivery charge rules ──────────────────────────────
DELIVERY_BASE_FARE=40
DELIVERY_BASE_KM=2
DELIVERY_PER_EXTRA_KM=10
DELIVERY_MAX_KM=25
FREE_DELIVERY_ABOVE=500
FREE_DELIVERY_WITHIN_KM=2
DEFAULT_DELIVERY_MINUTES=30

# ── Payment: Razorpay ──────────────────────────────────
PAYMENT_MODE=mock
RAZORPAY_PAYMENT_LINK=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Social / contact (floating buttons + about page) ───
CONTACT_WHATSAPP=
CONTACT_PHONE=
CONTACT_INSTAGRAM=
INSTAGRAM_HANDLE=
INSTAGRAM_FOLLOW_DISCOUNT=10

# ── Business identifiers ────────────────────────────────
FSSAI_LICENSE=
GST_NUMBER=

# ── Optional: Google Maps for real road distance ───────
GOOGLE_MAPS_API_KEY=

# ── Developer credit (footer) ──────────────────────────
DEVELOPER_NAME=
DEVELOPER_URL=
